{%- comment -%}
  Outputs a piece's measurements, e.g. "23/30" (pit to pit / length, inches).
  Uses the custom.measurements metafield when set, otherwise the start of the
  description, which Max writes as "23/30 | tagged XL".
{%- endcomment -%}
{%- liquid
  assign m = product.metafields.custom.measurements.value | default: ''
  if m == blank
    comment
      Keep only the leading numbers: "25/29(xl)", "23/28, fits XL" and "23/30 | tagged XL" all give the first part.
    endcomment
    assign first_line = product.description | split: '</p>' | first | strip_html | remove: ' '
    assign chars = first_line | split: ''
    for ch in chars
      if '0123456789./' contains ch
        assign m = m | append: ch
      else
        break
      endif
    endfor
    assign m = m | remove_last: '.'
    unless m contains '/'
      assign m = ''
    endunless
    assign tail = m | split: '/' | last
    if tail == blank or m == tail
      assign m = ''
    endif
  endif
  echo m
-%}
