{
  "name": "hawkscloset-storefront",
  "private": true,
  "scripts": {
    "preview:render": "python3 scripts/render-password-preview.py",
    "preview": "python3 scripts/render-password-preview.py && node scripts/render-gallery-preview.cjs && python3 scripts/preview-server.py",
    "test": "node --test tests/countdown.test.cjs",
    "theme:check": "shopify theme check --path hawks-closet-theme",
