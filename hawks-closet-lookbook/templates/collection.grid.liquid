{% comment %}
  AJAX "Load More" for collection pages — Lookbook variant.
  Hard-pinned to drop-02 regardless of which collection handle is in the URL.
{% endcomment %}
{% paginate collections['drop-02'].products by 40 %}
  {% for product in collections['drop-02'].products %}
    {% render 'product-card', product: product %}
  {% endfor %}
  {% if paginate.next %}
    <div id="nextPageUrl" data-url="{{ paginate.next.url }}&view=grid" style="display:none"></div>
  {% endif %}
{% endpaginate %}
