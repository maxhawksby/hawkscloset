{% comment %}
  Filter drawer — slides in from the left.
  Size taxonomy comes from theme settings (settings.size_filter_options, comma-separated).
  Each pill carries `data-size="L"` etc.; URL sync + grid hide/show logic live in script.js.
{% endcomment %}

{%- assign size_options_raw = settings.size_filter_options | default: 'XS,S,M,L,XL,XXL,OS' -%}
{%- assign size_options = size_options_raw | split: ',' -%}

<aside class="filter-drawer" id="filterDrawer" aria-hidden="true">
  <div class="filter-head">
    <span class="drawer-head-label">Filter</span>
    <button class="drawer-x" type="button" onclick="closeFilter()" aria-label="Close filters">
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M1 1l12 12M13 1L1 13" stroke="#000" stroke-width="1.4"/></svg>
    </button>
  </div>

  <div class="filter-body">
    <section class="filter-section">
      <h3 class="filter-section-label">Size</h3>
      <div class="filter-pills" id="filterPillsSize" role="group" aria-label="Filter by size">
        {% for raw in size_options %}
          {%- assign s = raw | strip -%}
          {% if s != '' %}
            <button type="button" class="filter-pill" data-size="{{ s | escape }}" aria-pressed="false">{{ s | escape }}</button>
          {% endif %}
        {% endfor %}
      </div>
    </section>
  </div>

  <div class="filter-foot">
    <button type="button" class="filter-clear" onclick="clearFilter()">Clear All</button>
    <button type="button" class="filter-apply" onclick="closeFilter()">
      <span>View</span>
      <span class="filter-apply-count" id="filterApplyCount">0</span>
    </button>
  </div>
</aside>
