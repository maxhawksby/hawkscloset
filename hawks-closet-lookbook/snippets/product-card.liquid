{% comment %}
  Product card snippet — Lookbook variant.
  Usage: {% render 'product-card', product: product %}

  Shows the first <p> of the product description in place of price
  (e.g. "23.5/29 | tagged XL" per Hawks Closet's description boilerplate).
  No purchase data attributes — the lookbook has no cart.
{% endcomment %}

{% assign sold = false %}
{% unless product.available %}
  {% assign sold = true %}
{% endunless %}

{% assign condition = product.metafields.custom.condition.value | default: '' %}
{% assign size      = product.metafields.custom.size.value      | default: product.variants.first.title %}
{% assign era       = product.metafields.custom.era.value       | default: '' %}
{% assign material  = product.metafields.custom.material.value  | default: '' %}

{% assign first_line = product.description | split: '</p>' | first | replace: '<p>', '' | strip_html | strip %}

{% if product.featured_image %}
  {% assign img_url = product.featured_image | image_url: width: 800 %}
{% else %}
  {% assign img_url = '' %}
{% endif %}

{%- capture imgs_json -%}
[{% for image in product.images %}"{{ image | image_url: width: 1400 }}"{% unless forloop.last %},{% endunless %}{% endfor %}]
{%- endcapture -%}

<div class="grid-cell{% if sold %} sold{% endif %}"
  data-id="{{ product.id }}"
  data-name="{{ product.title | escape }}"
  data-sold="{{ sold }}"
  data-meas="{{ first_line | escape }}"
  data-cond="{{ condition | escape }}"
  data-size="{{ size | escape }}"
  data-era="{{ era | escape }}"
  data-material="{{ material | escape }}"
  data-desc="{{ product.description | escape }}"
  data-img="{{ img_url }}"
  data-imgs="{{ imgs_json | escape }}"
  onclick="openProduct(this)">

  <div class="grid-img">
    {% if product.featured_image %}
      <img
        src="{{ product.featured_image | image_url: width: 800 }}"
        alt="{{ product.featured_image.alt | default: product.title | escape }}"
        loading="lazy">
    {% else %}
      <div class="grid-ph">
        <svg width="36" height="36" viewBox="0 0 36 36" fill="none">
          <rect x="4" y="8" width="28" height="22" rx="2" stroke="#ccc" stroke-width="1.5"/>
          <path d="M4 14h28" stroke="#ccc" stroke-width="1.5"/>
          <circle cx="18" cy="23" r="4" stroke="#ccc" stroke-width="1.5"/>
        </svg>
      </div>
    {% endif %}
    <div class="sold-tag"><span>Sold</span></div>
  </div>

  <div class="grid-info">
    <p class="grid-name">{{ product.title | escape }}</p>
    <p class="grid-meas">{{ first_line | escape }}</p>
  </div>

</div>
