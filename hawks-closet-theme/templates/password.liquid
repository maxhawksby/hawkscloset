{% layout none %}
<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ shop.name | escape }} | Next drop</title>
  {{ content_for_header }}
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@300;400;500;600&display=swap" rel="stylesheet">
  {{ 'password.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'drop-countdown.js' | asset_url }}" defer></script>
  <script src="{{ 'password-signup.js' | asset_url }}" defer></script>
</head>
<body>

<div class="screen" style="--password-background: url('{{ 'password-background.webp' | asset_url }}');">
  <div class="bg" aria-hidden="true"></div>
  <div class="bg-overlay" aria-hidden="true"></div>
  <div class="scene-light" aria-hidden="true"></div>

  <!-- Password — top left -->
  {% form 'storefront_password' %}
    <div class="pw-corner">
      <span class="pw-corner-label">Early access</span>
      {% if form.errors %}
        <p class="pw-error">Wrong password.</p>
      {% endif %}
      <input
        class="pw-input"
        aria-label="Store password"
        type="password"
        name="password"
        placeholder="Password"
        autocomplete="current-password">
      <button class="pw-btn-ghost" type="submit">Enter &rarr;</button>
    </div>
  {% endform %}

  <!-- Logo — top center -->
  <div class="logo-wrap">
    <img class="logo-img" src="{{ 'logo.png' | asset_url }}" width="32" height="36" alt="Hawks Closet">
  </div>

  <!-- Timer + SMS — centered as one unit -->
  <main class="center-block">

    <section class="countdown-section" aria-label="Next drop" data-drop-countdown data-drop-at="{{ settings.next_drop_at | escape }}" data-time-zone="America/New_York">
      <h1 class="countdown-eyebrow" data-drop-status>Drop goes live in</h1>
      <div class="countdown-stage">
        <div class="countdown-grid" role="timer" aria-label="Time until the next drop" aria-live="off">
          <div class="countdown-unit"><span class="countdown-num" data-unit="days">--</span><span class="countdown-label">Days</span></div>
          <div class="countdown-unit"><span class="countdown-num" data-unit="hours">--</span><span class="countdown-label">Hrs</span></div>
          <div class="countdown-unit"><span class="countdown-num" data-unit="minutes">--</span><span class="countdown-label">Min</span></div>
          <div class="countdown-unit"><span class="countdown-num" data-unit="seconds">--</span><span class="countdown-label">Sec</span></div>
        </div>
      </div>
      {% if settings.next_drop_at != blank %}
        <time class="countdown-date" data-drop-date datetime="{{ settings.next_drop_at | escape }}">{{ settings.next_drop_at | date: '%B %d, %Y at %I:%M %p %Z' }}</time>
      {% else %}
        <p class="countdown-date">Next drop date to be announced.</p>
      {% endif %}
    </section>

    <div class="sms-section">
      <p class="sms-headline">Get notified when we drop.</p>
      <p class="sms-sub">Leave your number for next-drop updates.</p>
      <form class="sms-form" id="smsForm" data-public-key="{{ settings.klaviyo_public_key | default: 'TALeYF' | escape }}" data-list-id="{{ settings.klaviyo_sms_list_id | default: 'X9XfPw' | escape }}">
        <label class="sr-only" for="smsPhone">Phone number</label>
        <input
          class="sms-input"
          type="tel"
          id="smsPhone"
          aria-describedby="smsMsg"
          placeholder="(201) 555-0100"
          autocomplete="tel"
          inputmode="tel">
        <label class="sms-consent">
          <input type="checkbox" id="smsConsent">
          <span class="sms-consent-text">I agree to receive recurring automated marketing text messages at this number. Msg &amp; data rates may apply. Reply STOP to unsubscribe.</span>
        </label>
        <button class="sms-btn" id="smsSubmit" type="submit">Notify me &rarr;</button>
        <p class="sms-msg" id="smsMsg" role="status" aria-live="polite"></p>
      </form>
      <noscript><p class="sms-sub">Enable JavaScript to sign up for texts, or follow @hawks.vtg for updates.</p></noscript>
    </div>

  </main>

  <!-- Instagram — bottom center -->
  <p class="ig-line">
    Follow the drop &middot; <a href="https://instagram.com/{{ settings.instagram_handle | default: 'hawks.vtg' }}" target="_blank" rel="noopener noreferrer">@{{ settings.instagram_handle | default: 'hawks.vtg' }}</a>
  </p>
</div>



</body>
</html>
